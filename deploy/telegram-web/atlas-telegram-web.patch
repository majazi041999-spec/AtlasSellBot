diff --git a/src/lib/gramjs/extensions/atlasProxy.ts b/src/lib/gramjs/extensions/atlasProxy.ts
new file mode 100644
index 0000000..75886fc
--- /dev/null
+++ b/src/lib/gramjs/extensions/atlasProxy.ts
@@ -0,0 +1,23 @@
+// Atlas panel build: when this client is served from the admin panel (".../tg/"),
+// every Telegram web endpoint is reached through our own server instead of
+// *.web.telegram.org, which is filtered in Iran. nginx relays
+// "<panel>/tgws/<dc>/<path>" to "https://<dc>.web.telegram.org/<path>"; the
+// traffic stays MTProto-encrypted end to end, the relay only forwards it.
+const TELEGRAM_WEB_SUFFIX = '.web.telegram.org';
+
+function detectProxyBase(): string | undefined {
+  try {
+    const { host, pathname } = self.location;
+    const i = pathname.indexOf('/tg/');
+    return i >= 0 ? `${host}${pathname.slice(0, i)}/tgws` : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+const PROXY_BASE = detectProxyBase();
+
+export function atlasProxyLink(scheme: 'wss' | 'https', ip: string, path: string): string | undefined {
+  if (!PROXY_BASE || !ip.endsWith(TELEGRAM_WEB_SUFFIX)) return undefined;
+  return `${scheme}://${PROXY_BASE}/${ip.slice(0, -TELEGRAM_WEB_SUFFIX.length)}/${path}`;
+}
