[Unit]
Description=Pass encrypted subscription traffic to the origin reverse tunnel
Requires=atlas-sub-entry.socket
After=atlas-sub-entry.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:18443
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
