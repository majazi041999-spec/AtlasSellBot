# On the origin only. Replace ENTRY_IP and provision a dedicated restricted key.
# The remote key must permit only the two loopback remote-forward listeners,
# deny shell/commands/agent/X11/PTY, and deny unrestricted local forwarding.
[Unit]
Description=Reverse tunnel for the unchanged Atlas subscription URLs
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ssh -NT -i /etc/atlas-sub-entry/id_ed25519 -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/atlas-sub-entry/known_hosts -o ExitOnForwardFailure=yes -o ConnectTimeout=10 -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -R 127.0.0.1:18443:127.0.0.1:443 -R 127.0.0.1:18080:127.0.0.1:80 atlas-sub-entry@ENTRY_IP
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
